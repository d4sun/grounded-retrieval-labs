# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Secrets — never commit API keys
.env
*.key

# Data: raw corpora and derived artefacts are large / licence-encumbered.
data/raw/*
!data/raw/.gitkeep
data/index/
data/artefacts/
.cache/
caption_cache/

# The synthetic sample is generated on demand (scripts.make_sample_corpus,
# or automatically by run_ingest) — don't commit the generated blobs.
data/sample/*
!data/sample/.gitkeep
